# -----------------------------------------------------------------------------
# ReplyX AI — Environment Configuration Template (.env.example)
# -----------------------------------------------------------------------------
# Copy this file to .env.local for localhost development, or configure these
# variables in Netlify -> Site Configuration -> Environment Variables for production.
# -----------------------------------------------------------------------------

# 1. Database Configuration
# Localhost: SQLite file-based database (default)
# Production (Netlify / Cloud): PostgreSQL URL (Supabase, Neon, Railway, CockroachDB)
DATABASE_URL="file:./dev.db"

# 2. Authentication & Security
# Secret key used to sign JWT authentication cookies (min 32 characters)
JWT_SECRET="your_secure_jwt_secret_key_here"

# 32-byte secret key for AES-256-GCM symmetric encryption of Page Tokens & API Keys at rest
ENCRYPTION_KEY="your_32_character_encryption_key!"

# 3. Facebook Developer App Configuration
# Required for Messenger Webhook validation & Graph API integration
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_GRAPH_API_VERSION="v20.0"
FACEBOOK_WEBHOOK_VERIFY_TOKEN="replyx_custom_verify_token_2026"

# 4. AI Provider API Keys (Optional Global Fallbacks)
# Users can also configure and encrypt their own keys directly in Settings UI.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# 5. Production & Webhook Base URLs
# Production: Set to your live Netlify domain (e.g. https://your-site.netlify.app or custom domain)
APP_URL="http://localhost:3000"

# Localhost Webhook Tunnel: Optional override for ngrok / cloudflared tunnel during local testing
# Example: WEBHOOK_BASE_URL="https://your-tunnel.ngrok-free.app"
WEBHOOK_BASE_URL=""
