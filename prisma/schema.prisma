datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String        @id @default(uuid())
  fullName      String
  businessName  String
  facebookPageUrl String?
  email         String        @unique
  passwordHash  String
  phone         String?
  avatarUrl     String?
  role                    String        @default("USER") // USER, ADMIN
  status                  String        @default("ACTIVE") // ACTIVE, DISABLED
  plan                    String        @default("STARTER") // FREE, STARTER, BUSINESS, PRO
  planStatus              String        @default("INACTIVE") // INACTIVE, PENDING_APPROVAL, ACTIVE, EXPIRED
  monthlyMessageLimit     Int           @default(500)
  messagesSentThisMonth   Int           @default(0)
  planExpiresAt           DateTime?
  activePackageId         String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  activePackage Package?        @relation(fields: [activePackageId], references: [id], onDelete: SetNull)
  packageOrders PackageOrder[]
  pages         Page[]
  products      Product[]
  conversations Conversation[]
  messages      Message[]
  orders        Order[]
  aiSettings    AiSetting[]
  activityLogs  ActivityLog[]

  @@index([email])
  @@index([role])
  @@index([planStatus])
}

model Page {
  id                        String        @id @default(uuid())
  userId                    String
  facebookPageId            String
  pageName                  String
  pageUsername              String?
  pageProfileImage          String?
  pageAccessTokenEncrypted   String
  verifyTokenEncrypted      String
  webhookUrl                String?
  webhookStatus             String        @default("PENDING") // ACTIVE, PENDING, ERROR
  connectionStatus          String        @default("CONNECTED") // CONNECTED, DISCONNECTED, TOKEN_EXPIRED, PENDING
  autoReplyEnabled          Boolean       @default(true)
  humanHandoffEnabled       Boolean       @default(true)
  replyLanguage             String        @default("AUTO") // AUTO, BANGLA, ENGLISH, BANGLISH
  replyStyle                String        @default("FRIENDLY") // PROFESSIONAL, FRIENDLY, SALES_FOCUSED, SHORT, CASUAL
  aiInstructions            String?
  productImageReply         Boolean       @default(true)
  orderDetection            Boolean       @default(true)
  voiceProcessing           Boolean       @default(true)
  imageUnderstanding        Boolean       @default(true)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  user                      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  products                  Product[]
  conversations             Conversation[]
  messages                  Message[]
  orders                    Order[]
  activityLogs              ActivityLog[]

  @@unique([userId, facebookPageId])
  @@index([userId])
  @@index([facebookPageId])
}

model Product {
  id                    String        @id @default(uuid())
  userId                String
  pageId                String?
  name                  String
  description           String?
  sku                   String?
  category              String?
  price                 Float
  discountPrice         Float?
  stockQuantity         Int           @default(0)
  stockStatus           String        @default("IN_STOCK") // IN_STOCK, OUT_OF_STOCK, PRE_ORDER
  imageUrl              String?
  deliveryInfo          String?
  productAiInstructions String?
  isActive              Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  page                  Page?         @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pageId])
  @@index([name])
}

model Conversation {
  id            String        @id @default(uuid())
  userId        String
  pageId        String
  senderPsid    String
  customerName  String?
  lastMessage   String?
  lastMessageAt DateTime      @default(now())
  status        String        @default("ACTIVE") // ACTIVE, HUMAN_MODE, RESOLVED
  aiEnabled     Boolean       @default(true)
  unreadCount   Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  page          Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  messages      Message[]
  orders        Order[]

  @@unique([pageId, senderPsid])
  @@index([userId])
  @@index([pageId])
  @@index([senderPsid])
  @@index([lastMessageAt])
}

model Message {
  id              String        @id @default(uuid())
  conversationId  String
  userId          String
  pageId          String
  senderPsid      String
  direction       String        // INCOMING, OUTGOING
  messageType     String        @default("TEXT") // TEXT, IMAGE, AUDIO, VIDEO, ATTACHMENT, UNKNOWN
  messageText     String?
  mediaUrl        String?
  transcription   String?
  aiGenerated     Boolean       @default(false)
  aiModel         String?
  createdAt       DateTime      @default(now())

  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  page            Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([userId])
  @@index([pageId])
  @@index([createdAt])
}

model Order {
  id              String        @id @default(uuid())
  userId          String
  pageId          String
  conversationId  String?
  customerName    String
  phone           String
  address         String
  product         String
  productId       String?
  quantity        Int           @default(1)
  price           Float         @default(0)
  totalPrice      Float         @default(0)
  notes           String?
  status          String        @default("PENDING") // PENDING, CONFIRMED, PROCESSING, DELIVERED, CANCELLED
  source          String        @default("MESSENGER_AI") // MESSENGER_AI, MANUAL
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  page            Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pageId])
  @@index([status])
  @@index([phone])
  @@index([createdAt])
}

model AiSetting {
  id              String        @id @default(uuid())
  userId          String
  provider        String        @default("GEMINI") // GEMINI, OPENAI
  model           String        @default("gemini-1.5-flash")
  encryptedApiKey String?
  temperature     Float         @default(0.7)
  maxTokens       Int           @default(800)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model ActivityLog {
  id          String        @id @default(uuid())
  userId      String
  pageId      String?
  action      String
  description String
  metadata    String?
  createdAt   DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  page        Page?         @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pageId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  description     String?
  price           Float          @default(0)
  durationDays    Int            @default(30)
  messageLimit    Int            @default(1000)
  pageLimit       Int            @default(1)
  productLimit    Int            @default(50)
  features        String         @default("[]")
  isPopular       Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders          PackageOrder[]
  users           User[]

  @@index([slug])
  @@index([isActive])
}

model PaymentMethod {
  id              String         @id @default(uuid())
  name            String         @unique // BKASH, NAGAD, ROCKET, UPAY
  displayName     String         // বিকাশ, নগদ, রকেট, উপায়
  accountType     String         @default("PERSONAL") // PERSONAL, MERCHANT, AGENT
  accountNumber   String         // 01XXXXXXXXX
  instructions    String?
  qrCodeUrl       String?
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  orders          PackageOrder[]

  @@index([name])
  @@index([isActive])
}

model PackageOrder {
  id                String         @id @default(uuid())
  orderNumber       String         @unique
  userId            String
  packageId         String
  paymentMethodId   String?
  paymentMethodName String
  amount            Float
  senderNumber      String
  transactionId     String
  status            String         @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote         String?
  paymentProofUrl   String?
  approvedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  package           Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@index([orderNumber])
}

